			<string>replyVoice</string>
			<key>DefaultValue</key>
			<string>kokoro</string>
			<key>Values</key>
			<array>
				<string>apple</string>
				<string>kokoro</string>
			</array>
			<key>Titles</key>
			<array>
				<string>Apple voice</string>
				<string>Kokoro (Neural Engine)</string>
			</array>
		</dict>
	</array>
